<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- bâtiment déplacé à la main par le code, pas un pawn (sinon anim de marche moche) -->
	<ThingDef ParentName="BuildingBase">
		<defName>RimSiege_BatteringRam</defName>
		<label>battering ram</label>
		<description>A wheeled ram under a wooden roof. A crew shelters beneath it and drives the iron head into a door or wall. Slow, but no wall likes it.</description>
		<thingClass>RimSiege.Things.Building_BatteringRam</thingClass>
		<drawerType>RealtimeOnly</drawerType>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Pawn</altitudeLayer>
		<selectable>true</selectable>
		<useHitPoints>true</useHitPoints>
		<fillPercent>0.35</fillPercent>
		<passability>Standable</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<statBases>
			<MaxHitPoints>900</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<WorkToBuild>3500</WorkToBuild>
		</statBases>
		<!-- constructible = les blueprints existent pour le chantier ennemi.
		     Archotech le cache du menu du joueur sans bloquer les assiégeants -->
		<designationCategory>Security</designationCategory>
		<minTechLevelToBuild>Archotech</minTechLevelToBuild>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<costList>
			<WoodLog>220</WoodLog>
			<Steel>40</Steel>
		</costList>
		<!-- sprites 4 directions (art: Tom), canvas carré donc drawSize carré -->
		<graphicData>
			<texPath>Things/Pawn/SiegeEngine/BatteringRam</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<building>
			<isEdifice>false</isEdifice>
		</building>
	</ThingDef>

	<!-- même principe, mais au mur elle dépose les assaillants derrière au lieu de casser -->
	<ThingDef ParentName="BuildingBase">
		<defName>RimSiege_SiegeTower</defName>
		<label>siege tower</label>
		<description>A tall wooden tower on wheels. A crew pushes it up to the rampart; once docked, the drawbridge drops and the attackers pour over the wall. The wall stays standing - they come over the top.</description>
		<thingClass>RimSiege.Things.Building_SiegeTower</thingClass>
		<drawerType>RealtimeOnly</drawerType>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Pawn</altitudeLayer>
		<selectable>true</selectable>
		<useHitPoints>true</useHitPoints>
		<fillPercent>0.4</fillPercent>
		<passability>Standable</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<statBases>
			<MaxHitPoints>1200</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<WorkToBuild>5000</WorkToBuild>
		</statBases>
		<designationCategory>Security</designationCategory>
		<minTechLevelToBuild>Archotech</minTechLevelToBuild>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<costList>
			<WoodLog>350</WoodLog>
			<Steel>60</Steel>
		</costList>
		<!-- sprites 4 directions (art: Tom) -->
		<graphicData>
			<texPath>Things/Building/SiegeTower/SiegeTower</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5,5)</drawSize>
		</graphicData>
		<building>
			<isEdifice>false</isEdifice>
		</building>
	</ThingDef>

	<!-- kit tribal : un tronc sur poignées de corde, porté par quatre (deux de chaque côté), sans toit ni roues -->
	<ThingDef ParentName="BuildingBase">
		<defName>RimSiege_LogRam</defName>
		<label>log ram</label>
		<description>A heavy log lashed with rope grips. Four warriors carry it at a run, two on each side, and swing it into a door or wall until something gives. No roof over their heads.</description>
		<thingClass>RimSiege.Things.Building_LogRam</thingClass>
		<drawerType>RealtimeOnly</drawerType>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Pawn</altitudeLayer>
		<selectable>true</selectable>
		<useHitPoints>true</useHitPoints>
		<fillPercent>0.2</fillPercent>
		<passability>Standable</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<statBases>
			<MaxHitPoints>450</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<designationCategory>Security</designationCategory>
		<minTechLevelToBuild>Archotech</minTechLevelToBuild>
		<costList>
			<WoodLog>90</WoodLog>
		</costList>
		<!-- sprites 4 directions (art : BenFD), poignées à 2 cases d'écart avec drawSize 5 -->
		<graphicData>
			<texPath>Things/Building/LogRam/LogRam</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5,5)</drawSize>
		</graphicData>
		<building>
			<isEdifice>false</isEdifice>
		</building>
	</ThingDef>

	<!-- kit tribal : posée contre le rempart, les guerriers montent un par un. une seule image vue de dessus qui tourne -->
	<ThingDef ParentName="BuildingBase">
		<defName>RimSiege_SiegeLadder</defName>
		<label>siege ladder</label>
		<description>A long rough ladder. Two warriors run it up to the rampart and lean it on the wall, then the war band climbs over one at a time. The wall stays standing.</description>
		<thingClass>RimSiege.Things.Building_SiegeLadder</thingClass>
		<drawerType>RealtimeOnly</drawerType>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Pawn</altitudeLayer>
		<selectable>true</selectable>
		<useHitPoints>true</useHitPoints>
		<fillPercent>0.15</fillPercent>
		<passability>Standable</passability>
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>true</rotatable>
		<statBases>
			<MaxHitPoints>220</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<WorkToBuild>900</WorkToBuild>
		</statBases>
		<designationCategory>Security</designationCategory>
		<minTechLevelToBuild>Archotech</minTechLevelToBuild>
		<costList>
			<WoodLog>60</WoodLog>
		</costList>
		<!-- art : Deon (Deep And Deeper - Ladder retexture), avec permission. 267x866 px, 267 px par case -->
		<graphicData>
			<texPath>Things/Building/SiegeLadder/SiegeLadder</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,3.24)</drawSize>
		</graphicData>
		<building>
			<isEdifice>false</isEdifice>
		</building>
	</ThingDef>

</Defs>
